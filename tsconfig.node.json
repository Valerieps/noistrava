{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "server/**/*.test.ts",
    "server/testing",
    "vite.config.ts",
    "network-policy.ts"
  ],
  "exclude": [
    "server/entry/*.test.ts",
    "server/testing/worker.ts",
    "server/testing/cloudflare-workers.ts"
  ]
}
